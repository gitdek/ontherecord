#!/bin/sh
# Refuses a commit that carries something that looks like a credential. Turned on once per clone with
#   git config core.hooksPath .githooks
# The made-up credentials that test the notebook's guard are marked `gitleaks:allow` where they stand.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks isn't installed (brew install gitleaks), so nothing was checked" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
