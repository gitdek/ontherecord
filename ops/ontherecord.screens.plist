<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Local picture model for screen search, with its vision file (unloads after 10 idle minutes). Each of the two
     slots holds 8192 tokens: a frame is about 940 and the longest search the app sends at most about 6,000. -->
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>ontherecord.screens</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/llama-server</string>
		<string>--embedding</string>
		<string>--pooling</string>
		<string>last</string>
		<string>--model</string>
		<string>__MODEL__</string>
		<string>--mmproj</string>
		<string>__MMPROJ__</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8802</string>
		<string>--api-key-file</string>
		<string>__KEYFILE__</string>
		<string>--ctx-size</string>
		<string>16384</string>
		<string>--batch-size</string>
		<string>2048</string>
		<string>--ubatch-size</string>
		<string>2048</string>
		<string>--parallel</string>
		<string>2</string>
		<string>--no-webui</string>
		<string>--sleep-idle-seconds</string>
		<string>600</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__ROOT__/data/logs/screens.log</string>
	<key>StandardOutPath</key>
	<string>__ROOT__/data/logs/screens.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>Umask</key>
	<!-- 63 is 077: the logs launchd creates are this user's only -->
	<integer>63</integer>
</dict>
</plist>
