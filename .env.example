# Copy to .env and fill in. The server reads it on start (node --env-file-if-exists=.env).

PORT=8797
HOST=127.0.0.1
MEETINGS_DIR=/Users/you/Pictures/Screenshots/meetings
# The folder must be a real path; set this to 1 only if MEETINGS_DIR is a symlink on purpose.
# MEETINGS_DIR_ALLOW_LINK=1

# Cloudflare Access: the team domain and the application's AUD tag
# (Zero Trust → Access → Applications → meetings → Overview → Application Audience (AUD) Tag).
# Until both are set, the server refuses every request that didn't come straight from this Mac.
# If /mcp gets its own Access application (to sign agents in with Managed OAuth), list both AUD tags,
# comma separated.
ACCESS_TEAM=your-team.cloudflareaccess.com
ACCESS_AUD=

# Who may in, and what to call them: email=Name, comma separated. Required: nobody gets in without it.
ACCESS_USERS=ada@example.com=Ada,grace@example.com=Grace

# Agents with Access service tokens: <client id>=<name>[:write], comma separated. They can read; add
# :write to let one work the board and the notebook (e.g. 1a2b….access=Grace's Hermes:write).
ACCESS_SERVICE_TOKENS=

# Links handed to agents point here.
PUBLIC_URL=https://meetings.example.com

# Sites whose hosted assistants may call /mcp and /mcp/readonly when their connector sends an Origin
# (comma separated; these are the defaults). Access still decides who gets in. Empty: this site only.
# MCP_ORIGINS=https://claude.ai,https://claude.com

# Viewers who start in light mode until they choose (by name).
LIGHT_MODE_USERS=Grace

# Local embedding server for meaning search (ops/install.sh embed MODEL.gguf fills these in).
EMBED_URL=
EMBED_KEY=
EMBED_MODEL=

# Optional on-screen search (docs/screen-search.md), off unless set:
#   local       pictures and searches are matched on this Mac by the model at SCREENS_URL, which has to be
#               127.0.0.1, localhost or [::1] (ops/install.sh screens MODEL.gguf MMPROJ.gguf fills these in).
#               Nothing leaves the Mac, and OPENROUTER_API_KEY is never read.
#   1 or gemini selected frames and explicit screen queries go to OpenRouter and its Google provider
#               (google/gemini-embedding-2), with OPENROUTER_API_KEY.
SCREEN_SEARCH=0
SCREENS_URL=
SCREENS_KEY=
SCREENS_MODEL=
OPENROUTER_API_KEY=

# Local reranker that sharpens the context agents pull and the search page's ranking (ops/install.sh rerank
# MODEL.gguf fills these in).
RERANK_URL=
RERANK_KEY=

# Local chat model that answers a question from the archive's own passages, with citations (ops/install.sh
# ask MODEL.gguf fills these in). Empty: the app doesn't offer to answer.
ASK_URL=
ASK_KEY=
ASK_MODEL=

# Telling speakers apart (README, "Who is speaking"). These are the defaults; set DIARIZE_PYTHON= (empty)
# to turn it off.
# DIARIZE_PYTHON=/Users/you/models/diarization/venv/bin/python
# DIARIZE_SEGMENTATION=/Users/you/models/diarization/segmentation/sherpa-onnx-pyannote-segmentation-3-0/model.onnx
# DIARIZE_EMBEDDING=/Users/you/models/diarization/embedding/nemo_en_titanet_large.onnx

# Where caches, shared state, the notebook and logs live (default: ./data).
# DATA_DIR=

# More folders that get a copy of the board, the notebook and the speaker names, comma separated: another
# disk, say, or a Google Drive folder. data/backups/ always gets one, at start and once a day, and each keeps
# a week of copies. Those copies need a disk formatted APFS or Mac OS Extended. A folder that can't keep a file
# private (exFAT or FAT, as many new external drives come) is named in the log once and gets none.
# Each folder also gets a copy of the whole meetings folder, in its meetings/ folder. It only adds and updates:
# a file removed from the meetings folder stays in the copy. The folder must already exist. Secrets (.env, the
# model keys, data/connector.json) are never copied. See docs/recovery.md.
# BACKUP_DIR=/Volumes/Backup/meetings

# The second hostname, where agents sign in with the server's own OAuth: Claude's apps, and Claude Code, Codex or
# Hermes on someone's own machine. It is routed to the same tunnel with no Access application on it and serves only
# that sign-in and the two MCP doors. The approval page stays on PUBLIC_URL, behind Access. Empty: off.
# CONNECTOR_URL=https://meetings-mcp.example.com
# The callback addresses an assistant may register there, comma separated (loopback is always allowed).
# CONNECTOR_REDIRECTS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# The Cloudflare tunnel's id. ops/install.sh tunnel looks it up once by name and keeps it here, so the tunnel
# runs on its own credentials file.
# TUNNEL_ID=

# Name used for requests made locally on this Mac (no Access token).
LOCAL_USER=Ada

# The hosts: their action items land in the "on us" lane and they get headphones.
CREW=Ada Byron,Grace Hopper
